        text document_type FK
        text archival_policy FK
        date carton_created_date
        date retention_trigger_date
        integer declared_file_count
        text assigned_vendor_id FK
        text barcode
        text remarks
        bigint source_row_id FK, UK
    }
    FILE_RECORD {
        text file_id PK
        text carton_id FK
        text file_ref
        text document_type FK
        text file_description
        integer document_year
        boolean contains_pii
        bigint source_row_id FK, UK
    }
    SERVICE_REQUEST {
        text request_id PK
