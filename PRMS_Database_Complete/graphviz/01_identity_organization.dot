digraph schema {
graph [rankdir=TB, bgcolor="#f6f8fc", pad=0.5, nodesep=0.55, ranksep=1.0, splines=polyline, fontname="DejaVu Sans", label="01 Identity Organization\nPK = primary key | FK = foreign key | ? = nullable\nEdges: referencing table to referenced table. Cross-module FKs are listed in the dictionary.", labelloc=t, fontsize=20];
node [shape=plain,fontname="DejaVu Sans"];
edge [color="#7893ad",arrowsize=0.65,fontname="DejaVu Sans",fontsize=9];
"business_entity" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d8e0eb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12344d"><FONT COLOR="white"><B>business_entity</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">entity_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">entity_name</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR></TABLE>>];
"department" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d8e0eb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12344d"><FONT COLOR="white"><B>department</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">department_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">entity_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">department_name</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR></TABLE>>];
"vendor" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d8e0eb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12344d"><FONT COLOR="white"><B>vendor</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">vendor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vendor_name</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">contract_start ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">date</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">contract_ref ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ops_contact_email ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">recertification_frequency</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR></TABLE>>];
"warehouse" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d8e0eb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12344d"><FONT COLOR="white"><B>warehouse</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">location_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">vendor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">location_name</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">city</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">capacity_cartons ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">integer</FONT></TD></TR></TABLE>>];
"app_user" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d8e0eb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12344d"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">role_code</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">entity_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">department_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">vendor_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">password_hash ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">timestamptz</FONT></TD></TR></TABLE>>];
"user_session" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d8e0eb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12344d"><FONT COLOR="white"><B>user_session</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">token_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">revoked_at ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">timestamptz</FONT></TD></TR></TABLE>>];
{rank=same;"business_entity";"department";}
"business_entity" -> "department" [style=invis,weight=100];
{rank=same;"vendor";"warehouse";}
"vendor" -> "warehouse" [style=invis,weight=100];
{rank=same;"app_user";"user_session";}
"app_user" -> "user_session" [style=invis,weight=100];
"business_entity" -> "vendor" [style=invis,weight=100];
"vendor" -> "app_user" [style=invis,weight=100];
"department" -> "business_entity" [constraint=false,label="entity_id"];
"warehouse" -> "vendor" [constraint=false,label="vendor_id"];
"app_user" -> "business_entity" [constraint=false,label="entity_id"];
"app_user" -> "vendor" [constraint=false,label="vendor_id"];
"app_user" -> "department" [constraint=false,label="entity_id, department_id"];
"user_session" -> "app_user" [constraint=false,label="user_id"];
}