digraph schema {
graph [rankdir=TB, bgcolor="#f6f8fc", pad=0.5, nodesep=0.55, ranksep=1.0, splines=polyline, fontname="DejaVu Sans", label="04 Cartons Workflow\nPK = primary key | FK = foreign key | ? = nullable\nEdges: referencing table to referenced table. Cross-module FKs are listed in the dictionary.", labelloc=t, fontsize=20];
node [shape=plain,fontname="DejaVu Sans"];
edge [color="#7893ad",arrowsize=0.65,fontname="DejaVu Sans",fontsize=9];
"carton" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d8e0eb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12344d"><FONT COLOR="white"><B>carton</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">carton_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">entity_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">department_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">owner_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">document_type</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">archival_policy</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">carton_created_date</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">date</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">retention_trigger_date ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">date</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">declared_file_count ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">assigned_vendor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">barcode ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">remarks ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">source_row_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">bigint</FONT></TD></TR></TABLE>>];
"file_record" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d8e0eb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12344d"><FONT COLOR="white"><B>file_record</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">file_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">carton_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">file_ref</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">document_type</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">file_description ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">document_year ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">contains_pii</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">source_row_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">bigint</FONT></TD></TR></TABLE>>];
"service_request" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d8e0eb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12344d"><FONT COLOR="white"><B>service_request</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">request_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">carton_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">request_type</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">vendor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">raised_by</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">raised_at</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">request_status</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">destination ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vendor_ack_at ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">completed_at ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">approved_by ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">approved_at ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">rejection_reason ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">sla_rule_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">sla_snapshot ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">sla_due_date ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">date</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">source_row_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">bigint</FONT></TD></TR></TABLE>>];
"carton_state" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d8e0eb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12344d"><FONT COLOR="white"><B>carton_state</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK</TD><TD ALIGN="LEFT">carton_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">status_code</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">custody</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">vendor_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">warehouse_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">active_hold_count</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">state_since</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">last_event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">rebuilt_at</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">timestamptz</FONT></TD></TR></TABLE>>];
{rank=same;"carton";"file_record";}
"carton" -> "file_record" [style=invis,weight=100];
{rank=same;"service_request";"carton_state";}
"service_request" -> "carton_state" [style=invis,weight=100];
"carton" -> "service_request" [style=invis,weight=100];
"file_record" -> "carton" [constraint=false,label="carton_id, document_type"];
"service_request" -> "carton" [constraint=false,label="carton_id"];
"carton_state" -> "carton" [constraint=false,label="carton_id"];
}