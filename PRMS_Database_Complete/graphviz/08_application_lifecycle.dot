digraph flow {
graph [rankdir=TB,bgcolor="#f6f8fc",pad=0.4,nodesep=0.7,ranksep=0.7,fontname="DejaVu Sans",fontsize=22,labelloc=t,label="Application lifecycle"];
node [shape=box,style="rounded,filled",fillcolor="white",color="#a9bed2",fontname="DejaVu Sans",fontsize=13,margin="0.25,0.17"];
edge [fontname="DejaVu Sans",fontsize=11,color="#547995"];
A [label="Business: register carton and index files"];
B [label="Business: request pickup"];
C [label="Vendor: acknowledge and collect"];
D [label="IN TRANSIT - not yet stored"];
E [label="Vendor: warehouse receipt"];
F [label="IN STORAGE"];
G [label="Business: request retrieval"];
H [label="Vendor: deliver to business"];
I [label="WITH BUSINESS"];
J [label="Business: request return"];
K [label="Vendor: receive return"];
L [label="Retention expired?"];
M [label="Business: request destruction"];
N [label="Compliance: verify and approve"];
O [label="Vendor: recheck hold, approval and custody"];
P [label="Destroy and record evidence"];
Q [label="DESTROYED - terminal physical state"];
R [label="Refuse with reason / wait for eligibility",fillcolor="#ffe8e2"];
A -> B [label=""];
B -> C [label=""];
C -> D [label=""];
D -> E [label=""];
E -> F [label=""];
F -> G [label="Retrieve"];
G -> H [label=""];
H -> I [label=""];
I -> J [label=""];
J -> K [label=""];
K -> F [label=""];
F -> L [label="Dispose"];
L -> M [label="Yes"];
L -> R [label="No"];
M -> N [label="No hold + in warehouse"];
M -> R [label="Hold / not in warehouse"];
N -> O [label="Approved"];
N -> R [label="Rejected or blocked"];
O -> P [label="Eligible"];
O -> R [label="Hold / invalid state"];
P -> Q [label=""];
}