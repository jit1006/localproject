digraph schema {
graph [rankdir=TB, bgcolor="#f6f8fc", pad=0.5, nodesep=0.55, ranksep=1.0, splines=polyline, fontname="DejaVu Sans", label="05 Events Custody Holds\nPK = primary key | FK = foreign key | ? = nullable\nEdges: referencing table to referenced table. Cross-module FKs are listed in the dictionary.", labelloc=t, fontsize=20];
node [shape=plain,fontname="DejaVu Sans"];
edge [color="#7893ad",arrowsize=0.65,fontname="DejaVu Sans",fontsize=9];
"event_log" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d8e0eb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12344d"><FONT COLOR="white"><B>event_log</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">stream_kind</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">stream_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">stream_version</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">carton_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">request_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">event_type</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">occurred_at</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">recorded_at</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">actor_user_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">actor_role</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">actor_reference ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">channel</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">source_event_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">source_row_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">from_location_ref ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">to_location_ref ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">resulting_status ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">schema_version</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">payload</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">corrects_event_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">idempotency_key</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR></TABLE>>];
"custody_interval" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d8e0eb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12344d"><FONT COLOR="white"><B>custody_interval</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">interval_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">carton_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">custody</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">vendor_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">warehouse_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">valid_from</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">valid_to ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">start_event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">end_event_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">bigint</FONT></TD></TR></TABLE>>];
"legal_hold" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d8e0eb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12344d"><FONT COLOR="white"><B>legal_hold</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">hold_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">carton_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">matter_reference</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">raised_by ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">starts_at</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">start_precision</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">applied_event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">released_at ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">release_precision ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">released_by ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">release_reason ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">text</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">released_event_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">source_row_id ?</TD><TD ALIGN="LEFT"><FONT COLOR="#526475">bigint</FONT></TD></TR></TABLE>>];
{rank=same;"event_log";"custody_interval";}
"event_log" -> "custody_interval" [style=invis,weight=100];
{rank=same;"legal_hold";}
"event_log" -> "legal_hold" [style=invis,weight=100];
"event_log" -> "event_log" [constraint=false,label="corrects_event_id"];
"custody_interval" -> "event_log" [constraint=false,label="carton_id, start_event_id"];
"custody_interval" -> "event_log" [constraint=false,label="carton_id, end_event_id"];
"legal_hold" -> "event_log" [constraint=false,label="carton_id, applied_event_id"];
"legal_hold" -> "event_log" [constraint=false,label="carton_id, released_event_id"];
}