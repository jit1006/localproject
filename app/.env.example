# Copy to backend/.env and fill in. NEVER commit a real .env.
# All variables are prefixed PRMS_ (see backend/app/config.py).

# Runtime database login — MUST be non-owner, non-superuser (see 03_runtime_grants.sql).
PRMS_DATABASE_URL=postgresql+psycopg://prms_app:change-me@localhost:5432/prms

# Schema created by sql/01_schema.sql.
PRMS_DB_SCHEMA=prms

# Session signing secret — generate a long random value per environment.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PRMS_SESSION_SECRET=change-me-to-a-long-random-value
PRMS_SESSION_TTL_MINUTES=480
PRMS_SECURE_COOKIES=false

# CORS origin for the Vite dev server.
PRMS_FRONTEND_ORIGIN=http://localhost:5173

PRMS_ENVIRONMENT=development
